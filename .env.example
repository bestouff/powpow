# Listen address
LISTEN_ADDRESS=127.0.0.1:3000

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/helloasso_users

# HelloAsso API Configuration
HELLOASSO_CLIENT_ID=your_client_id_here
HELLOASSO_CLIENT_SECRET=your_client_secret_here
HELLOASSO_ASSOCIATION_SLUG=your_association_slug_here

# Mailchimp API Configuration (optional)
MAILCHIMP_API_KEY=your_api_key-usX
MAILCHIMP_SERVER_PREFIX=usX
MAILCHIMP_LIST_ID=your_audience_id
MAILCHIMP_FROM_NAME=AGHIL
MAILCHIMP_FROM_EMAIL=contact@example.com

# Mail method: "smtp" (default) or "gmail"
MAIL_METHOD=smtp

# SMTP Configuration (when MAIL_METHOD=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_password
SMTP_FROM=AGHIL <noreply@example.com>

# Gmail Configuration (when MAIL_METHOD=gmail)
# Requires a Google Cloud project with Gmail API enabled and OAuth2 credentials
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REDIRECT_URI=http://localhost
GMAIL_ACCESS_TOKEN=your_access_token
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_FROM=your_email@gmail.com

# Override all outgoing mail destination (useful for testing)
# When set, all login emails are sent to this address instead of the staff member's email
#MAIL_DESTINATION_ADDRESS_OVERRIDE=test@example.com

# Cookie secret (optional, for signed session cookies - at least 64 hex chars)
COOKIE_SECRET=a-long-random-string-at-least-64-hex-chars

# Automation tokens (optional, for headless /sync and /backup access)
# Pass as ?token= query param or Authorization: Bearer header
#SYNC_TOKEN=a-random-secret-token
#BACKUP_TOKEN=a-random-secret-token

# Hugging Face Inference API token (optional, enables "dicton du jour" on home page)
#HUGGINGFACE_TOKEN=hf_your_token_here

# RSS feed URL for the "Actualités" section on the home page (optional)
#RSS_NEWS_FEED=https://rss.app/feeds/XXXX.xml

# Météo-France six-minute observation archive (optional)
# SAINT-HILAIRE_SAPC, 990 m, Saint-Hilaire-du-Touvet
METEO_FRANCE_STATION_ID=38395004
# Application credential: value after "Authorization: Basic" in the portal's token cURL.
# Enables automatic OAuth2 access-token renewal; takes precedence over METEO_FRANCE_TOKEN.
#METEO_FRANCE_APPLICATION_ID=your_application_credential
# Alternatively, a temporary bearer token (replace and restart when it expires):
#METEO_FRANCE_TOKEN=your_access_token

# Webcam: embedded explicit FTPS uploads (optional; enabled by username/password)
#FTPS_TITLE="Vue sur les pistes"
#FTPS_USERNAME=station
#FTPS_PASSWORD=replace-with-a-random-password
#FTPS_TLS_CERT=/etc/powpow-tls/fullchain.pem
#FTPS_TLS_KEY=/etc/powpow-tls/privkey.pem
#FTPS_LISTEN_ADDRESS=0.0.0.0:2121
#FTPS_PASSIVE_PORTS=50000-50009
#FTPS_PASSIVE_HOST=webcam.example.com
#WEBCAM_DIRECTORY=/var/lib/powpow/webcam

# Webcam: retrieve snapshots from an HTTP(S) URL (optional; set URL and period)
# Works independently of FTPS and uses the same archive and image validation.
# Period: a positive whole number followed by s, m, h, or d.
#DIRECT_WEBCAM_URL=https://camera.example/snapshot.jpg
#DIRECT_WEBCAM_PERIOD=6m
# Archive source name: 1–64 ASCII letters, digits, hyphens, or underscores (default: direct).
#DIRECT_WEBCAM_NAME=pistes
# Display title for this source (defaults to FTPS_TITLE, or Webcam).
#DIRECT_WEBCAM_TITLE="Vue sur les pistes"
# GPS for EXIF in newly received images (HTTP and FTPS): latitude,longitude, decimal degrees.
# Leave empty to omit configured GPS; timestamps and author are always written.
#DIRECT_WEBCAM_COORDINATES=45.31,5.85
# Skip TLS certificate and hostname verification for direct snapshots (default: false).
#DIRECT_WEBCAM_INSECURE_TLS=false

# Entity name used in emails and UI
#ENTITY_NAME="AG'HIL"

# Entity contact email (optional)
#ENTITY_EMAIL=contact@example.com

# Optional: Logging level
RUST_LOG=info
## Public address, including any reverse-proxy path prefix. Used for emailed links.
PUBLIC_BASE_URL=http://localhost:3000
## Development Compose only: use the database's password, or generate one with openssl rand -hex 24.
DEV_POSTGRES_PASSWORD=
